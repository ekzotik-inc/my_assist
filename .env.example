# Скопируй этот файл в .env и впиши свои значения:  cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore). Реальные ключи держи только здесь.

# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=put-your-fresh-bot-token-here

# Ключ и адрес ИИ-провайдера (OpenAI-совместимый API)
AI_API_KEY=put-your-fresh-ai-key-here
AI_BASE_URL=https://console.openmodel.ai/v1
AI_MODEL=deepseek-v4-flash

# Системный промпт — как ассистент должен себя вести
SYSTEM_PROMPT=Ты — вежливый ассистент, отвечающий клиентам от имени владельца бизнеса. Отвечай кратко, по делу и дружелюбно на языке клиента.

# Сколько последних сообщений диалога помнить (контекст)
HISTORY_LIMIT=10
