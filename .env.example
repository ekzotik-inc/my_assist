# Скопируй этот файл в .env и впиши свои значения:  cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore). Реальные ключи держи только здесь.

# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=put-your-fresh-bot-token-here

# Ключ Google Gemini (бесплатный) из https://aistudio.google.com/api-keys
AI_API_KEY=put-your-fresh-ai-key-here
# Gemini через OpenAI-совместимый endpoint (менять не нужно)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Модель: gemini-2.5-flash | gemini-2.5-flash-lite | gemini-2.5-pro
AI_MODEL=gemini-2.5-flash
MAX_TOKENS=1024

# Твой Telegram user id — только он управляет обучением бота.
# Узнать id: напиши боту @userinfobot
OWNER_ID=0

# Самообучение: 1 — бот сам записывает новые факты из диалогов, 0 — выключено
AUTO_LEARN=1

# Файлы знаний (можно не менять)
KNOWLEDGE_FILE=cases.txt
MEMORY_FILE=memory.jsonl

# Базовый стиль/персона. Подробные знания и кейсы — в cases.txt.
SYSTEM_PROMPT=Ты — Денис, ассистент поддержки фронтлайна. Отвечай коротко, на «ты», без воды, по делу. Опирайся на базу кейсов. Если ответа нет — честно скажи и попроси скрин, шаги и время ошибки. Не обещай сроков.

# Сколько последних сообщений диалога помнить (контекст)
HISTORY_LIMIT=10
